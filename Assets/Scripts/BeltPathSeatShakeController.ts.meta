  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">BeltPathSeatShakeController – grab-and-shake stand-in for the car seat</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input SceneObject seatRoot {"hint":"The movable CarSeat root. Only its X position changes; it springs back to where it started."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input vec3 grabBoxSizeCm = "{48,14,46}" {"hint":"Size (cm) of the grab box around the seat base (belt path height). Big so it is easy to pinch, but no taller than 14 cm: the answer buttons and card float just above it, and a taller box would catch the click ray before them."}'
    - '// @input float returnSettleWT = 6.4 {"hint":"Critically damped return: w*T at which the spring counts as home (6.4 leaves ~1% of the offset, then it snaps to 0). Keep it at 6 or more: lower values leave a visible snap at the end.", "widget":"slider", "min":6, "max":10, "step":0.1}'
    - '// @input bool debugCollider {"hint":"Show the grab collider wireframe for debugging."}'
    - '// @ui {"widget":"group_end"}'
