  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">BeltPathMain – flow of the 1-inch belt path check</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input AssignableType_1 seatShake {"hint":"Grab-and-shake controller on CarSeat/SeatGrabHandle."}'
    - '// @input AssignableType_2 overlay {"hint":"Belt path band + ghost outline controller."}'
    - '// @input AssignableType_3 ruler {"hint":"Vehicle-anchored 10 cm ruler."}'
    - '// @input AssignableType_4 answers {"hint":"The two answer buttons (10 cm above the belt path)."}'
    - '// @input AssignableType_5 resultCard {"hint":"Result card (same spot as the buttons)."}'
    - '// @input AssignableType_6 demoToggle {"hint":"Demo-only Loose/Tight toggle on the left door armrest."}'
    - '// @input AssignableType_7 offViewCue {"hint":"Edge-of-view arrow pointing at the seat when it is out of view at start."}'
    - '// @input AssignableType_8 audio {"hint":"Chime / click cues."}'
    - '// @input SceneObject beltPathTarget {"hint":"Point on the belt path used to test whether the seat is in view."}'
    - '// @input AssignableType_9 startLabels {"hint":"\"Belt path\" + the shake hint \"Grab the seat here and shake\", shown for 3 s at every near start."}'
    - '// @input AssignableType_10 alignZero {"hint":"One-time pinch on the seat edge that sets the ruler 0 (no input = ruler already aligned)."}'
    - '// @input SceneObject edgePin {"hint":"Edge pin on the car seat; hidden until the ruler is aligned."}'
    - '// @input SceneObject buckleTarget {"hint":"The seat belt buckle on the bench; outlined with the red card (step 1 \"Lock the belt\"). No input = no highlight."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float looseLimitCm = 4 {"hint":"Demo setting: how far the seat can move in Loose mode (cm). Crosses the 2.5 cm line.", "widget":"slider", "min":0.5, "max":8, "step":0.5}'
    - '// @input float tightLimitCm = 1 {"hint":"Demo setting: how far the seat can move in Tight mode (cm).", "widget":"slider", "min":0, "max":4, "step":0.25}'
    - '// @input string defaultMode = "Loose" {"hint":"Demo mode at start.", "widget":"combobox", "values":[{"label":"Loose", "value":"Loose"}, {"label":"Tight", "value":"Tight"}]}'
    - '// @input bool reduceMotion {"hint":"Reduce motion: every animation is instant (all durations 0). The seat still follows the hand 1:1."}'
    - "// @input float inViewRadiusCm = 4 {\"hint\":\"Radius (cm) around the belt path target that must be in view to count as 'in view'.\", \"widget\":\"slider\", \"min\":1, \"max\":20, \"step\":0.5}"
    - '// @ui {"widget":"group_end"}'
