    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input SceneObject bandRoot {"hint":"BeltPathBand group on the car seat; every RenderMeshVisual under it is faded and highlighted."}'
